{
  "metadata": {
        "title": "Test ET",
        "description": "Construction d'un modele PYWR Next pour la Lienne, avec Input CSV pour le catchement",
        "minimum_version": "0.1"
  },
  "timestepper": {
        "start": "2015-01-01",
        "end": "2015-01-15",
        "timestep": {
        "type": "Days",
        "days": 1
        }
  },
  "network": {
        "nodes": [
            {
                "meta": {
                "name": "catchment1"
                },
                "type": "Catchment",
                "flow": {
                    "type": "Timeseries",
                    "name": "Input_Flow_ts"
                }
            },
            {
                "meta": {
                "name": "term1"
                },
                "type": "Output"
            }
        ],
        "timeseries":[
            {
                "meta": {
                "name": "Input_Flow_ts"
                },
                "type": "Polars",
                "time_col": "date",
                "url": "Input_Flow.csv"
            }
        ],
        "edges": [
            {
                "from_node": "catchment1",
                "to_node": "term1"
            }
        ],
        "metric_sets": [
            {
                "name": "nodes",
                "filters": {
                "all_nodes": true
                }
            }
            ],
        "outputs": [
            {
                "name": "node-outputs",
                "type": "CSV",
                "format": "Long",
                "filename": "Test_ET.csv",
                "metric_set": [
                "nodes"
                ]
            }
        ]
  }
}